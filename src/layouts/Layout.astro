---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Eshin Griffith is a software engineer building dependable systems and developer tools.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf4ed" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#191724" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="terminal-shell">
      <Header />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --base: #faf4ed;
    --surface: #fffaf3;
    --overlay: #f2e9e1;
    --muted: #9893a5;
    --subtle: #797593;
    --text: #575279;
    --love: #b4637a;
    --gold: #ea9d34;
    --rose: #d7827e;
    --pine: #286983;
    --foam: #56949f;
    --iris: #907aa9;
    --iris-rgb: 144 122 169;
    --shell-shadow: rgb(87 82 121 / 18%);
    --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --base: #191724;
      --surface: #1f1d2e;
      --overlay: #26233a;
      --muted: #6e6a86;
      --subtle: #908caa;
      --text: #e0def4;
      --love: #eb6f92;
      --gold: #f6c177;
      --rose: #ebbcba;
      --pine: #31748f;
      --foam: #9ccfd8;
      --iris: #c4a7e7;
      --iris-rgb: 196 167 231;
      --shell-shadow: rgb(0 0 0 / 28%);
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    min-width: 20rem;
    min-height: 100%;
    background: var(--base);
  }

  body {
    min-height: 100vh;
    min-height: 100svh;
    margin: 0;
    padding: clamp(0rem, 2.5vw, 1.5rem);
    overflow-wrap: anywhere;
    color: var(--text);
    background:
      radial-gradient(circle at top, rgb(var(--iris-rgb) / 8%), transparent 38rem),
      var(--base);
    font-family: var(--font-sans);
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.125rem);
    line-height: 1.65;
  }

  .terminal-shell {
    display: flex;
    flex-direction: column;
    width: min(70rem, 100%);
    min-height: calc(100vh - clamp(0rem, 5vw, 3rem));
    min-height: calc(100svh - clamp(0rem, 5vw, 3rem));
    margin-inline: auto;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--muted);
    border-radius: 0.75rem;
    box-shadow: 0 1.5rem 4rem var(--shell-shadow);
  }

  main {
    flex: 1;
    min-width: 0;
    width: 100%;
    padding: clamp(1.5rem, 4vw, 4rem);
  }

  h1,
  h2,
  h3 {
    line-height: 1.15;
    text-wrap: balance;
  }

  h1 {
    font-size: clamp(2.15rem, 6vw, 4.75rem);
    letter-spacing: -0.045em;
  }

  h2 {
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  p,
  li {
    max-width: 72ch;
  }

  a {
    color: var(--foam);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  a:hover {
    color: var(--rose);
  }

  :focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }

  code,
  pre,
  kbd,
  samp {
    font-family: var(--font-mono);
  }

  code {
    color: var(--rose);
  }

  pre {
    max-width: 100%;
    overflow-x: auto;
    padding: 1rem;
    background: var(--base);
    border: 1px solid var(--muted);
    border-radius: 0.4rem;
  }

  img,
  svg {
    max-width: 100%;
  }

  img {
    height: auto;
  }

  .skip-link {
    position: fixed;
    z-index: 10;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.65rem 0.85rem;
    transform: translateY(-200%);
    color: var(--base);
    background: var(--gold);
    border-radius: 0.25rem;
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .page-header {
    display: grid;
    gap: 0.75rem;
    margin-block-end: clamp(2rem, 5vw, 4rem);
    padding-block-end: clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--muted);
  }

  .page-header h1 {
    max-width: 16ch;
    margin: 0;
  }

  .prompt,
  .panel-label,
  .metric-value,
  .metric-label,
  .tag-list,
  .terminal-list,
  .button-link {
    font-family: var(--font-mono);
  }

  .prompt {
    margin: 0;
    color: var(--foam);
    font-size: 0.88rem;
  }

  .lede {
    max-width: 62ch;
    margin: 0;
    color: var(--subtle);
    font-size: clamp(1.08rem, 1rem + 0.45vw, 1.35rem);
  }

  .panel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
  }

  .panel {
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--overlay);
    border: 1px solid var(--muted);
    border-radius: 0.5rem;
  }

  .panel > :first-child {
    margin-top: 0;
  }

  .panel > :last-child {
    margin-bottom: 0;
  }

  .panel-label {
    margin-block: 0 0.75rem;
    color: var(--iris);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: 0.75rem;
  }

  .metric {
    min-width: 0;
    padding: 1rem;
    background: var(--base);
    border-left: 3px solid var(--pine);
  }

  .metric-value,
  .metric-label {
    display: block;
  }

  .metric-value {
    color: var(--gold);
    font-size: clamp(1.45rem, 3vw, 2.1rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .metric-label {
    margin-top: 0.4rem;
    color: var(--subtle);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .tag-list,
  .terminal-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .tag-list > * {
    max-width: 100%;
    padding: 0.3rem 0.55rem;
    color: var(--rose);
    background: var(--base);
    border: 1px solid var(--muted);
    border-radius: 0.25rem;
    font-size: 0.75rem;
  }

  .terminal-list {
    display: grid;
    gap: 0.7rem;
  }

  .terminal-list > li {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.35rem;
  }

  .terminal-list > li::before {
    content: ">";
    color: var(--love);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .button-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.65rem 1rem;
    color: var(--base);
    background: var(--foam);
    border: 1px solid var(--foam);
    border-radius: 0.3rem;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }

  .button-link:hover {
    color: var(--base);
    background: var(--rose);
    border-color: var(--rose);
  }

  @media (max-width: 40rem) {
    body {
      padding: 0;
    }

    .terminal-shell {
      min-height: 100vh;
      min-height: 100svh;
      border-block: 0;
      border-inline: 0;
      border-radius: 0;
    }

    main {
      padding: 1.35rem 1rem 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
