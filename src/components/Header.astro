---
import Navigation from "./Navigation.astro";
---

<header class="terminal-header">
  <div class="session-bar">
    <span class="window-controls" aria-hidden="true">
      <span class="control control-love"></span>
      <span class="control control-gold"></span>
      <span class="control control-pine"></span>
    </span>
    <p class="session-title">eshin@portfolio: ~</p>
    <span class="session-state">0:portfolio</span>
  </div>
  <Navigation />
</header>

<style>
  .terminal-header {
    flex: none;
    background: var(--overlay);
    border-bottom: 1px solid var(--muted);
  }

  .session-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 2.5rem;
    padding-inline: 0.85rem;
    border-bottom: 1px solid var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .window-controls {
    display: flex;
    gap: 0.45rem;
    justify-self: start;
  }

  .control {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
  }

  .control-love {
    background: var(--love);
  }

  .control-gold {
    background: var(--gold);
  }

  .control-pine {
    background: var(--pine);
  }

  .session-title {
    margin: 0;
    color: var(--subtle);
    line-height: 1;
  }

  .session-state {
    justify-self: end;
    color: var(--muted);
    text-transform: uppercase;
  }

  @media (max-width: 30rem) {
    .session-bar {
      grid-template-columns: auto 1fr;
      gap: 0.75rem;
    }

    .session-title {
      justify-self: end;
    }

    .session-state {
      display: none;
    }
  }
</style>
