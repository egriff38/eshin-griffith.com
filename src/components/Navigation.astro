---
const tabs = [
  { label: "Home", href: "/" },
  { label: "Work", href: "/work" },
  { label: "About", href: "/about" },
  {
    label: "Résumé",
    href: "/Eshin_Griffith_Resume.pdf",
    download: "Eshin_Griffith_Resume.pdf",
  },
];

const pathname =
  Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
---

<nav class="terminal-tabs" aria-label="Primary navigation">
  <ul>
    {
      tabs.map(({ label, href, download }) => {
        const isCurrent =
          !download &&
          (href === "/"
            ? pathname === href
            : pathname === href || pathname.startsWith(`${href}/`));

        return (
          <li>
            <a
              href={href}
              aria-current={isCurrent ? "page" : undefined}
              download={download}
            >
              {label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .terminal-tabs {
    max-width: 100%;
    overflow-x: auto;
    scrollbar-color: var(--muted) var(--overlay);
  }

  ul {
    display: flex;
    width: max-content;
    min-width: 100%;
    margin: 0;
    padding: 0 0.45rem;
    list-style: none;
  }

  li {
    flex: none;
  }

  a {
    display: block;
    padding: 0.8rem 0.85rem 0.7rem;
    color: var(--subtle);
    border-bottom: 2px solid transparent;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
  }

  a:hover {
    color: var(--text);
    background: var(--surface);
  }

  a[aria-current="page"] {
    color: var(--text);
    border-bottom-color: var(--love);
    background: var(--surface);
  }
</style>
